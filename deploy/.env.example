# AI Provider 密钥（apiservice → 沙箱透传）。留空的键不会注入沙箱。
# 填好后保存为 .env（start 脚本会自动从本模板创建）。
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
TOGETHERAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_MODEL=

# 端口配置（deploy.sh / deploy.bat 读取）。修改后重新运行部署脚本生效。
WEB_PORT=8080
DEMO_PORT=8088
DASHBOARD_PORT=18888
POSTGRES_PORT=5432
