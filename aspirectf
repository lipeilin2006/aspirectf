#!/usr/bin/env bash
# AspireCTF TUI：start / update / stop
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

run_action() {
  local action="${1:-}"
  shift || true

  case "$action" in
    start)
      bash "$SCRIPT_DIR/start.sh" "$@"
      ;;
    update)
      bash "$SCRIPT_DIR/update.sh" "$@"
      ;;
    stop)
      bash "$SCRIPT_DIR/stop.sh" "$@"
      ;;
    *)
      echo -e "${RED}用法: $0 [start|update|stop] [参数...]${NC}" >&2
      return 2
      ;;
  esac
}

if [ "$#" -gt 0 ]; then
  run_action "$@"
  exit $?
fi

while true; do
  printf '%s\n' '=========================================='
  printf '%s\n' '  AspireCTF 控制台'
  printf '%s\n' '=========================================='
  echo ""
  printf '%s\n' '  1) 启动 / 重建服务'
  printf '%s\n' '  2) 更新代码并重建服务'
  printf '%s\n' '  3) 停止服务（保留数据卷）'
  printf '%s\n' '  0) 退出'
  echo ""
  printf '%s' '请选择 [0-3]: '
  if ! IFS= read -r choice; then
    echo ""
    echo "已退出。"
    exit 0
  fi

  case "$choice" in
    1)
      run_action start
      ;;
    2)
      run_action update
      ;;
    3)
      run_action stop
      ;;
    0)
      echo "已退出。"
      exit 0
      ;;
    *)
      echo -e "${YELLOW}无效选项，请输入 0、1、2 或 3。${NC}"
      ;;
  esac

  echo ""
  if ! read -r -p "按 Enter 返回菜单..." _; then
    echo ""
    echo "已退出。"
    exit 0
  fi
done
