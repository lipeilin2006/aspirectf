<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">修改用户密码</MudText></TitleContent>
    <DialogContent>
        <MudText Class="mb-3">用户：@Username</MudText>
        <MudTextField T="string" Label="新密码" Variant="Variant.Outlined" InputType="InputType.Password" @bind-Value="Password" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">保存密码</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Username { get; set; } = "";
    private string Password { get; set; } = "";
    private void Cancel() => Dialog.Cancel();
    private void Submit() => Dialog.Close(DialogResult.Ok(Password));
}
