@page "/change-password"
@attribute [Authorize]
@inject UserService UserStore
@inject AuthenticationStateProvider AuthState

<PageTitle>修改密码 - AspireCTF</PageTitle>
<div class="page-head"><div><div class="eyebrow">ACCOUNT SECURITY / 06</div><h1>修改密码</h1><p class="page-lead">修改当前登录用户的密码。</p></div></div>
<div class="settings-card password-card">
    <div class="form-row"><label>当前密码</label><input class="input" type="password" @bind="_current" /></div>
    <div class="form-row"><label>新密码</label><input class="input" type="password" @bind="_next" /></div>
    <div class="form-actions"><button class="btn btn-primary" @onclick="SaveAsync">保存密码</button></div>
    @if (_message is not null) { <div class="alert alert-success">@_message</div> }
    @if (_error is not null) { <div class="alert alert-error">@_error</div> }
</div>
@code {
    private string _current = "";
    private string _next = "";
    private string? _message;
    private string? _error;
    private async Task SaveAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name;
        if (string.IsNullOrWhiteSpace(user) || await UserStore.AuthenticateAsync(user, _current) is null || !await UserStore.SetPasswordAsync(user, _next))
        { _error = "当前密码错误或新密码为空"; return; }
        _current = _next = ""; _message = "密码已修改";
    }
}
