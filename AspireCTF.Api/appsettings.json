{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AspireCTF.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "Sandbox": {
    "Provider": "PodmanApi",
    "Image": "ctf-opencode-sandbox:latest",
    "Endpoint": null,
    "MaxConcurrent": 3,
    "MaxQueueLength": 64,
    "TaskTimeoutMinutes": 20,
    "WorkspacesRoot": "workspaces",
    "KeepWorkspaceOnFinish": false,
    "AllowSimulation": false,
    "SimulatedFlag": "FLAG{simulation_pipeline_ok}",
    "PassthroughEnvKeys": [
      "OPENCODE_API_KEY",
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL",
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_BASE_URL",
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY",
      "GROQ_API_KEY",
      "OPENROUTER_API_KEY",
      "DEEPSEEK_API_KEY",
      "MISTRAL_API_KEY",
      "XAI_API_KEY",
      "COHERE_API_KEY",
      "TOGETHERAI_API_KEY",
      "OPENCODE_MODEL"
    ]
  },
  "Catalog": {
    "SamplesPath": "/opt/catalog",
    "Challenges": [
      {
        "Id": "demo-web-sqli",
        "Name": "Demo: 登录框 SQL 注入",
        "Category": "web",
        "Description": "Flask 登录接口存在经典 SQL 注入，审计源码并拿到 admin 账号的 flag。",
        "TargetUrl": "http://host.docker.internal:8088/login",
        "SourcePath": "demo-web-sqli"
      }
    ]
  },
  "Cors": {
    "AllowAny": true
  }
}
